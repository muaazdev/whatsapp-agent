# 1) Your WhatsApp agent key
#    WhatsApp > Settings > Agents > create one > open its chat > "View API key"
WHATSAPP_AGENT_KEY=paste-your-whatsapp-agent-key-here

# 2) Pick ONE brain: gemini (free), claude, or openai
AI_PROVIDER=gemini

# 3) Paste the key for the brain you picked (leave the others empty)
#    Free Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
#    Claude key: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
#    OpenAI key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# 4) Your time zone, as hours from UTC (Saudi = 3, Pakistan = 5, UAE = 4, UK winter = 0)
UTC_OFFSET_HOURS=3

# Optional: change the model for each brain
# GEMINI_MODEL=gemini-3.5-flash-lite
# CLAUDE_MODEL=claude-haiku-5-5
# OPENAI_MODEL=gpt-6-luna
